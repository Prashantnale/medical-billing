<%- include('../partials/layout-top') %>

<div class="w-full xl:grid xl:grid-cols-[minmax(0,1fr)_340px] xl:gap-5">

  <!-- ============ FORM COLUMN ============ -->
  <form id="bill-form" novalidate class="min-w-0 space-y-4" autocomplete="off">

    <!-- Invoice meta -->
    <section class="rounded-2xl bg-white p-4 shadow-sm ring-1 ring-slate-200 sm:p-5">
      <h2 class="mb-3 flex items-center gap-2 text-sm font-bold text-slate-700">
        <span class="flex h-6 w-6 items-center justify-center rounded-lg bg-teal-100 text-teal-700"><i data-lucide="file-text" class="h-3.5 w-3.5"></i></span>
        Invoice Details
      </h2>
      <div class="grid grid-cols-2 gap-3 lg:grid-cols-4">
        <div>
          <label for="invoiceNumber" class="field-label">Invoice No.</label>
          <input id="invoiceNumber" type="text" value="<%= nextInvoiceNumber %>" readonly
            class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm font-semibold text-slate-500">
        </div>
        <div>
          <label for="invoiceDate" class="field-label">Date *</label>
          <input id="invoiceDate" type="date" required
            class="field-input">
        </div>
        <div>
          <label for="invoiceTime" class="field-label">Time *</label>
          <input id="invoiceTime" type="time" required
            class="field-input">
        </div>
        <div>
          <label for="invoiceType" class="field-label">Invoice Type</label>
          <select id="invoiceType" class="field-input">
            <option>Tax Invoice</option>
            <option>Bill of Supply</option>
            <option>Retail Invoice</option>
            <option>GST Invoice</option>
            <option>Credit Invoice</option>
          </select>
        </div>
      </div>
    </section>

    <!-- Customer -->
    <section class="rounded-2xl bg-white p-4 shadow-sm ring-1 ring-slate-200 sm:p-5">
      <h2 class="mb-3 flex items-center gap-2 text-sm font-bold text-slate-700">
        <span class="flex h-6 w-6 items-center justify-center rounded-lg bg-teal-100 text-teal-700"><i data-lucide="user-round" class="h-3.5 w-3.5"></i></span>
        Customer / Party
      </h2>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
        <div class="sm:col-span-2 lg:col-span-1">
          <label for="customerName" class="field-label">Customer Name *</label>
          <input id="customerName" type="text" required maxlength="140" placeholder="Party / patient name"
            class="field-input" list="customer-suggestions">
          <datalist id="customer-suggestions"></datalist>
          <datalist id="medicines-list"></datalist>
          <datalist id="unit-suggestions">
            <% ['TAB', 'CAP', 'STRIP', 'BTL', 'VIAL', 'SYP', 'TUBE', 'SACHET', 'BOX', 'PCS', 'UNIT'].forEach(function (u) { %>
              <option value="<%= u %>"></option>
            <% }) %>
          </datalist>
        </div>
        <div>
          <label for="customerPhone" class="field-label">Phone</label>
          <input id="customerPhone" type="tel" maxlength="20" placeholder="Optional" class="field-input">
        </div>
        <div>
          <label for="customerDoctor" class="field-label">Doctor Name</label>
          <input id="customerDoctor" type="text" maxlength="120" placeholder="Optional" class="field-input" list="doctor-suggestions">
          <datalist id="doctor-suggestions"></datalist>
        </div>
        <div class="sm:col-span-2">
          <label for="customerAddress" class="field-label">Address</label>
          <input id="customerAddress" type="text" maxlength="300" placeholder="Optional" class="field-input">
        </div>
        <div>
          <label for="customerGstin" class="field-label">Customer GSTIN</label>
          <input id="customerGstin" type="text" maxlength="15" placeholder="15-char GSTIN" class="field-input uppercase">
        </div>
        <div>
          <label for="customerStateCode" class="field-label">State Code</label>
          <input id="customerStateCode" type="text" maxlength="2" placeholder="e.g. 27" class="field-input uppercase">
          <p class="mt-1 text-[11px] text-slate-400">Different state ⇒ IGST is used</p>
        </div>
      </div>
    </section>

    <!-- Items -->
    <section class="rounded-2xl bg-white p-4 shadow-sm ring-1 ring-slate-200 sm:p-5">
      <div class="mb-3 flex items-center justify-between">
        <h2 class="flex items-center gap-2 text-sm font-bold text-slate-700">
          <span class="flex h-6 w-6 items-center justify-center rounded-lg bg-teal-100 text-teal-700"><i data-lucide="pills" class="h-3.5 w-3.5"></i></span>
          Items <span id="item-count" class="rounded-full bg-slate-100 px-2 py-0.5 text-[11px] font-semibold text-slate-500">0</span>
        </h2>
        <button type="button" id="add-item-btn" class="flex items-center gap-1.5 rounded-xl bg-teal-700 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-teal-800 active:scale-[0.98]">
          <i data-lucide="plus" class="h-4 w-4"></i> Add Item
        </button>
      </div>

      <div id="items-container" class="space-y-3"></div>

      <p id="items-error" class="mt-3 hidden rounded-xl bg-red-50 px-4 py-3 text-sm text-red-700"></p>
    </section>

    <!-- Billing options -->
    <section class="rounded-2xl bg-white p-4 shadow-sm ring-1 ring-slate-200 sm:p-5">
      <h2 class="mb-3 flex items-center gap-2 text-sm font-bold text-slate-700">
        <span class="flex h-6 w-6 items-center justify-center rounded-lg bg-teal-100 text-teal-700"><i data-lucide="calculator" class="h-3.5 w-3.5"></i></span>
        Billing Options
      </h2>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <div>
          <label for="taxMode" class="field-label">GST Mode</label>
          <select id="taxMode" class="field-input">
            <option value="exclusive">GST Exclusive</option>
            <option value="inclusive">GST Inclusive</option>
          </select>
        </div>
        <div>
          <label for="taxSplit" class="field-label">Tax Split</label>
          <select id="taxSplit" class="field-input">
            <option value="cgst_sgst">CGST + SGST (Intra-state)</option>
            <option value="igst">IGST (Inter-state)</option>
          </select>
        </div>
        <div>
          <label for="paymentMode" class="field-label">Payment Mode</label>
          <select id="paymentMode" class="field-input">
            <option>Cash</option><option>UPI</option><option>Card</option><option>Cheque</option><option>Credit</option>
          </select>
        </div>
        <div class="flex items-end">
          <label class="flex min-h-[46px] w-full cursor-pointer items-center gap-2.5 rounded-xl border border-slate-300 px-3 py-2.5">
            <input id="roundOffEnabled" type="checkbox" checked class="h-5 w-5 rounded accent-teal-700">
            <span class="text-sm font-medium text-slate-700">Round Off Net Amount</span>
          </label>
        </div>
      </div>

      <!-- Additional charges -->
      <div class="mt-4">
        <div class="flex items-center justify-between">
          <p class="text-xs font-bold uppercase tracking-wide text-slate-400">Additional Charges</p>
          <button type="button" id="add-charge-btn" class="flex items-center gap-1 rounded-lg px-2.5 py-1.5 text-xs font-semibold text-teal-700 hover:bg-teal-50">
            <i data-lucide="plus" class="h-3.5 w-3.5"></i> Add Charge
          </button>
        </div>
        <div id="charges-container" class="mt-2 grid grid-cols-1 gap-2 sm:grid-cols-2"></div>
      </div>

      <div class="mt-4">
        <label for="notes" class="field-label">Notes (printed on invoice)</label>
        <input id="notes" type="text" maxlength="300" placeholder="Optional" class="field-input">
      </div>
    </section>

    <!-- Mobile sticky summary + submit -->
    <div class="fixed inset-x-0 bottom-14 z-20 border-t border-slate-200 bg-white/95 p-3 backdrop-blur md:static md:rounded-2xl md:border md:shadow-sm md:ring-1 md:ring-slate-200 md:backdrop-blur-none" style="padding-bottom: calc(0.75rem + env(safe-area-inset-bottom));">
      <div class="mx-auto flex max-w-7xl items-center gap-3">
        <div class="min-w-0 flex-1">
          <p class="text-[11px] font-medium uppercase tracking-wide text-slate-400">Net Amount</p>
          <p id="net-preview" class="truncate text-xl font-black text-teal-800">₹0.00</p>
        </div>
        <button type="submit" id="save-bill-btn" class="flex items-center gap-2 rounded-xl bg-teal-700 px-6 py-3.5 text-base font-bold text-white shadow-lg transition hover:bg-teal-800 active:scale-[0.98] disabled:opacity-60">
          <i data-lucide="save" class="h-5 w-5"></i> Save Bill
        </button>
      </div>
    </div>
  </form>

  <!-- ============ LIVE PREVIEW PANEL (desktop) ============ -->
  <aside class="no-print hidden xl:block">
    <div class="sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto rounded-2xl bg-white p-4 shadow-sm ring-1 ring-slate-200">
      <div class="mb-2 flex items-center justify-between">
        <h2 class="flex items-center gap-2 text-sm font-bold text-slate-700">
          <i data-lucide="eye" class="h-4 w-4 text-teal-700"></i> Live Summary
        </h2>
        <span class="rounded-full bg-teal-50 px-2 py-0.5 text-[10px] font-bold uppercase text-teal-700">Auto</span>
      </div>
      <div id="summary-totals" class="space-y-1.5 text-sm"></div>
    </div>
  </aside>
</div>

<style>
  .field-label { display:block; margin-bottom:.25rem; font-size:12px; font-weight:600; color:#475569; }
  .field-input { width:100%; border-radius:.75rem; border:1px solid #cbd5e1; padding:.625rem .75rem; font-size:16px; outline:none; transition:border-color .15s, box-shadow .15s; }
  .field-input:focus { border-color:#0d9488; box-shadow:0 0 0 3px rgba(13,148,136,.15); }
  .item-card { border:1px solid #e2e8f0; border-radius:1rem; padding:.875rem; background:#f8fafc; }
  @media (min-width: 1024px) { .item-grid { display:grid; grid-template-columns: repeat(12, minmax(0,1fr)); gap:.5rem; align-items:end; } }
</style>

<%- include('../partials/layout-bottom', { scripts: ['bill-form'] }) %>
