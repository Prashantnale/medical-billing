# ============================================================
# Bill Generation Software - Environment Configuration
# Copy this file to .env and fill in the values.
#   cp .env.example .env
# ============================================================

# --- Server ---
PORT=3000
# development | production
NODE_ENV=development

# --- MongoDB (supply your connection URL here) ---
# Local:  mongodb://127.0.0.1:27017/medical-billing
# Atlas:  mongodb+srv://medicaldata:<medicaldata@123432@>@cluster0.6fg4rxg.mongodb.net/
MONGODB_URI=

# --- Sessions ---
# Generate a long random secret, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Session lifetime in hours (default 8)
SESSION_MAX_AGE_HOURS=8

# --- Security ---
# The single origin allowed to call the API (no trailing slash).
# Local development: http://localhost:3000
APP_ORIGIN=http://localhost:3000
